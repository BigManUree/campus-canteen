# ============================================================
# 校园食堂订餐系统 - 环境配置文件
# ============================================================
# 说明：
# 1. 复制此文件为 .env 并根据实际情况修改配置
# 2. .env 文件不应提交到版本控制系统
# 3. 生产环境必须修改所有安全相关配置
# ============================================================

# ============================================================
# 运行环境
# ============================================================
ENV=development
# ENV=production

# ============================================================
# 服务器配置
# ============================================================
HOST=0.0.0.0
PORT=8000

# ============================================================
# 数据库配置
# ============================================================
DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/campus_canteen_order

# 数据库连接池配置
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# ============================================================
# JWT 安全配置（生产环境必须修改）
# ============================================================
JWT_SECRET=123456789
JWT_EXPIRE=7200

# ============================================================
# CORS 跨域配置
# ============================================================
# 开发环境：允许所有来源
CORS_ORIGINS=*

# 生产环境：指定具体域名（多个用逗号分隔）
# CORS_ORIGINS=https://your-domain.com,https://admin.your-domain.com,https://www.your-domain.com

# 是否允许携带凭证（cookies、authorization headers）
CORS_ALLOW_CREDENTIALS=true

# 允许的 HTTP 方法（* 表示所有方法）
CORS_ALLOW_METHODS=*
# CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS

# 允许的请求头（* 表示所有请求头）
CORS_ALLOW_HEADERS=*
# CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Requested-With

# 暴露给前端的响应头（可选）
CORS_EXPOSE_HEADERS=X-Process-Time,X-Request-ID

# 预检请求缓存时间（秒）
CORS_MAX_AGE=600

# ============================================================
# 文件上传配置
# ============================================================
MEDIA_UPLOAD_PATH=D:/campus-canteen/uploads
MAX_UPLOAD_SIZE=10

# ============================================================
# 日志配置
# ============================================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ============================================================
# 管理员注册配置
# ============================================================
# 管理员注册密钥（为空则不允许通过密钥注册）
ADMIN_REGISTER_KEY=your_admin_register_key_here

# ============================================================
# 业务配置
# ============================================================
# 未支付订单自动取消时间（分钟）
ORDER_AUTO_CANCEL_MINUTES=30

# 取餐码有效期（小时）
PICKUP_CODE_EXPIRE_HOURS=24

# ============================================================
# 短信配置（可选）
# ============================================================
SMS_API_KEY=
SMS_API_SECRET=

# ============================================================
# 邮件配置（可选）
# ============================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@example.com

# ============================================================
# 支付配置（可选）
# ============================================================
# 微信支付
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=

# 支付宝
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# ============================================================
# 生产环境推荐配置示例
# ============================================================
# ENV=production
# DATABASE_URL=mysql+pymysql://canteen_user:strong_password@localhost:3306/campus_canteen_order
# JWT_SECRET=use_openssl_rand_hex_32_to_generate_a_secure_key
# CORS_ORIGINS=https://your-domain.com,https://admin.your-domain.com
# CORS_ALLOW_CREDENTIALS=true
# CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
# CORS_ALLOW_HEADERS=Content-Type,Authorization
# LOG_LEVEL=WARNING

