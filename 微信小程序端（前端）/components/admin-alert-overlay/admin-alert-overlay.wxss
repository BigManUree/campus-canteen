.admin-alert-root {
  position: fixed;
  inset: 0;
  z-index: 99999;
}

.admin-alert-mask {
  position: absolute;
  inset: 0;
  background: rgba(9, 12, 25, 0.58);
  backdrop-filter: blur(10rpx);
}

.admin-alert-shell {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}

.admin-alert-card {
  position: relative;
  width: 100%;
  max-width: 640rpx;
  border-radius: 36rpx;
  padding: 34rpx 30rpx 30rpx;
  background: linear-gradient(180deg, rgba(255,255,255,0.98), rgba(246,247,255,0.96));
  box-shadow: 0 28rpx 90rpx rgba(4, 12, 28, 0.32);
  overflow: hidden;
  animation: adminAlertPop 0.28s ease-out;
}

.admin-alert-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 12rpx;
  background: linear-gradient(90deg, #5c7cfa 0%, #7c5cff 50%, #ff922b 100%);
}

.admin-alert-new_paid_order::before { background: linear-gradient(90deg, #ff922b 0%, #ff6b35 100%); }
.admin-alert-order_accepted::before { background: linear-gradient(90deg, #339af0 0%, #5c7cfa 100%); }
.admin-alert-order_ready_for_pickup::before { background: linear-gradient(90deg, #20c997 0%, #12b886 100%); }
.admin-alert-order_cancelled::before { background: linear-gradient(90deg, #ff6b6b 0%, #fa5252 100%); }
.admin-alert-refund_request_created::before { background: linear-gradient(90deg, #845ef7 0%, #7048e8 100%); }
.admin-alert-refund_status_update::before { background: linear-gradient(90deg, #ff922b 0%, #e8590c 100%); }

.admin-alert-glow {
  position: absolute;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  filter: blur(50rpx);
  opacity: 0.22;
}

.admin-alert-glow-left {
  left: 90rpx;
  top: 200rpx;
  background: #7c5cff;
}

.admin-alert-glow-right {
  right: 80rpx;
  bottom: 180rpx;
  background: #ff922b;
}

.admin-alert-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 26rpx;
}

.admin-alert-badge,
.admin-alert-queue {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.admin-alert-queue {
  color: #5f6b7a;
  background: #eef2f7;
}

.admin-alert-main {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
}

.admin-alert-icon {
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 18rpx 34rpx rgba(92, 124, 250, 0.22);
}

.admin-alert-icon text {
  font-size: 46rpx;
}

.admin-alert-texts {
  flex: 1;
  min-width: 0;
}

.admin-alert-title {
  display: block;
  font-size: 38rpx;
  line-height: 1.3;
  font-weight: 800;
  color: #172033;
}

.admin-alert-message {
  display: block;
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 1.75;
  color: #526071;
  white-space: pre-wrap;
}

.admin-alert-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 28rpx;
}

.meta-chip {
  padding: 12rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(237, 242, 255, 0.92);
  color: #425466;
  font-size: 24rpx;
  font-weight: 600;
}

.admin-alert-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 30rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
}

.action-btn::after {
  border: none;
}

.action-later {
  background: #eef2f7;
  color: #4f5d70;
}

.action-view {
  color: #ffffff;
  box-shadow: 0 18rpx 32rpx rgba(92, 124, 250, 0.28);
}

@keyframes adminAlertPop {
  0% {
    opacity: 0;
    transform: scale(0.9) translateY(28rpx);
  }
  100% {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

