/* pages/activity/activity.wxss */
.activity-page {
  min-height: 100vh;
  height: 100vh;
  background:
    radial-gradient(circle at top left, rgba(255, 214, 102, 0.32), transparent 28%),
    linear-gradient(180deg, #10203a 0%, #1f3f6b 45%, #f4efe6 45%, #f4efe6 100%);
}

.hero-panel {
  position: relative;
  padding: 34rpx 32rpx 42rpx;
  overflow: hidden;
}

.hero-noise {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(135deg, rgba(255,255,255,0.08) 25%, transparent 25%) -18rpx 0 / 36rpx 36rpx,
    linear-gradient(225deg, rgba(255,255,255,0.06) 25%, transparent 25%) -18rpx 0 / 36rpx 36rpx;
  opacity: 0.5;
}

.hero-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hero-kicker {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: rgba(255, 239, 213, 0.74);
}

.hero-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff5db;
}

.hero-subtitle {
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(255, 247, 232, 0.86);
}

.activity-scroll {
  height: calc(100vh - 228rpx);
}

.activity-list {
  padding: 0 24rpx 36rpx;
}

.activity-card {
  position: relative;
  margin-bottom: 28rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: #fffdf7;
  box-shadow: 0 20rpx 48rpx rgba(26, 42, 71, 0.14);
}

.activity-cover {
  width: 100%;
  height: 280rpx;
  display: block;
}

.cover-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 280rpx;
  background: linear-gradient(180deg, rgba(12, 24, 47, 0.06), rgba(12, 24, 47, 0.58));
}

.cover-topline {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  right: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hero-tag {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 248, 230, 0.18);
  border: 1rpx solid rgba(255, 248, 230, 0.4);
  color: #fff6df;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.status-chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-active {
  background: #ffe082;
  color: #6b3d00;
}

.status-upcoming {
  background: #d6ebff;
  color: #205a96;
}

.status-ended {
  background: rgba(255,255,255,0.7);
  color: #5b6273;
}

.activity-content {
  padding: 28rpx 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.activity-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1d2942;
}

.activity-subtitle {
  font-size: 24rpx;
  color: #9e6b32;
}

.activity-desc {
  font-size: 26rpx;
  line-height: 1.8;
  color: #48536a;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.meta-grid {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #fff7ea, #fffdf8);
}

.meta-item {
  display: flex;
  gap: 18rpx;
}

.meta-label {
  width: 72rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #9b7b4f;
}

.meta-value {
  flex: 1;
  font-size: 24rpx;
  color: #3e4c65;
  line-height: 1.6;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 10rpx;
  color: #305f9e;
}

.detail-text {
  font-size: 26rpx;
  font-weight: 600;
}

.detail-arrow {
  font-size: 32rpx;
}

.state-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 140rpx 48rpx;
}

.state-wrapper.empty {
  color: #f4efe6;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid rgba(255,255,255,0.2);
  border-top-color: #ffd666;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

.state-icon {
  font-size: 88rpx;
  margin-bottom: 16rpx;
}

.state-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff4d9;
}

.state-text {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: rgba(255, 244, 217, 0.82);
  text-align: center;
  line-height: 1.7;
}

.retry-btn {
  margin-top: 28rpx;
  background: #ffe082;
  color: #6b3d00;
  border: none;
  border-radius: 999rpx;
  padding: 0 38rpx;
  height: 78rpx;
  line-height: 78rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.retry-btn::after {
  border: none;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
