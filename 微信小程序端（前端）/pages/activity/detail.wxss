/* pages/activity/detail.wxss */
.detail-page {
  min-height: 100vh;
  height: 100vh;
  background: linear-gradient(180deg, #0d1f39 0%, #193761 34%, #f4efe6 34%, #f4efe6 100%);
}

.detail-navbar {
  height: 96rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #fff4d9;
}

.nav-back,
.nav-placeholder {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back {
  font-size: 40rpx;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 700;
}

.detail-scroll {
  height: calc(100vh - 96rpx);
}

.cover-shell {
  position: relative;
  margin: 0 24rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 48rpx rgba(14, 28, 48, 0.24);
}

.cover-image {
  width: 100%;
  height: 360rpx;
  display: block;
}

.cover-shadow {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(9, 20, 39, 0.06), rgba(9, 20, 39, 0.62));
}

.cover-status {
  position: absolute;
  right: 22rpx;
  top: 22rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.status-active {
  background: #ffe082;
  color: #6b3d00;
}

.status-upcoming {
  background: #d8ebff;
  color: #1f5f99;
}

.status-ended {
  background: rgba(255,255,255,0.78);
  color: #5e6677;
}

.content-shell {
  padding: 26rpx 24rpx 40rpx;
}

.headline-card,
.info-card,
.content-card {
  background: #fffdf8;
  border-radius: 26rpx;
  padding: 28rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 14rpx 34rpx rgba(24, 37, 59, 0.08);
}

.activity-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1d2942;
  line-height: 1.5;
}

.activity-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #99632f;
  line-height: 1.7;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #22324f;
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eee7dc;
}

.info-row.last {
  border-bottom: none;
  padding-bottom: 0;
}

.info-label {
  width: 124rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #98744d;
}

.info-value,
.info-link {
  flex: 1;
  font-size: 25rpx;
  color: #42516a;
  line-height: 1.7;
}

.info-link {
  color: #265f9d;
}

.content-text {
  font-size: 27rpx;
  color: #46546f;
  line-height: 1.95;
  white-space: pre-wrap;
}

.state-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 180rpx 48rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid rgba(255,255,255,0.2);
  border-top-color: #ffd666;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

.state-icon {
  font-size: 92rpx;
  margin-bottom: 18rpx;
}

.state-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff4d9;
}

.state-text {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: rgba(255, 244, 217, 0.84);
}

.retry-btn {
  margin-top: 28rpx;
  background: #ffe082;
  color: #6b3d00;
  border: none;
  border-radius: 999rpx;
  height: 78rpx;
  line-height: 78rpx;
  padding: 0 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.retry-btn::after {
  border: none;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

