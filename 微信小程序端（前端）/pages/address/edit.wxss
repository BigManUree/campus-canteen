/* pages/address/edit.wxss */
page {
  background: #f7f1e8;
  height: 100vh;
}

.address-edit-page {
  min-height: 100vh;
  height: 100vh;
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at top left, rgba(255, 183, 77, 0.16) 0, rgba(255, 183, 77, 0) 34%),
    radial-gradient(circle at top right, rgba(77, 208, 225, 0.14) 0, rgba(77, 208, 225, 0) 30%),
    linear-gradient(180deg, #111827 0%, #182033 24%, #f6efe4 24%, #f7f1e8 100%);
}

.ambient {
  position: absolute;
  border-radius: 999rpx;
  filter: blur(42rpx);
  opacity: 0.56;
  pointer-events: none;
}

.ambient-1 {
  width: 260rpx;
  height: 260rpx;
  right: -40rpx;
  top: 90rpx;
  background: rgba(255, 167, 38, 0.22);
}

.ambient-2 {
  width: 320rpx;
  height: 320rpx;
  left: -120rpx;
  top: 260rpx;
  background: rgba(38, 198, 218, 0.18);
}

.edit-scroll {
  height: 100%;
  position: relative;
  z-index: 1;
}

.edit-shell {
  padding: 24rpx 24rpx 56rpx;
}

.hero-panel {
  position: relative;
  overflow: hidden;
  border-radius: 34rpx;
  padding: 30rpx 28rpx;
  background: linear-gradient(135deg, rgba(18, 24, 39, 0.96) 0%, rgba(33, 41, 63, 0.92) 58%, rgba(79, 53, 34, 0.9) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 22rpx 60rpx rgba(8, 11, 20, 0.34);
}

.hero-panel::after {
  content: '';
  position: absolute;
  inset: 0;
  background:
    linear-gradient(120deg, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0) 24%),
    repeating-linear-gradient(90deg, rgba(255,255,255,0.03) 0 2rpx, transparent 2rpx 28rpx);
  pointer-events: none;
}

.hero-copy,
.hero-stats {
  position: relative;
  z-index: 1;
}

.hero-copy {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hero-kicker {
  color: rgba(255, 224, 178, 0.78);
  font-size: 20rpx;
  letter-spacing: 6rpx;
}

.hero-title {
  color: #fff8ee;
  font-size: 50rpx;
  font-weight: 800;
  line-height: 1.18;
}

.hero-subtitle {
  color: rgba(255, 248, 238, 0.74);
  font-size: 24rpx;
  line-height: 1.7;
}

.hero-stats {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10rpx;
}

.hero-stat {
  min-height: 92rpx;
  border-radius: 18rpx;
  padding: 14rpx 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.warm-card {
  background: linear-gradient(135deg, rgba(255, 183, 77, 0.18) 0%, rgba(255, 167, 38, 0.1) 100%);
}

.cool-card {
  background: linear-gradient(135deg, rgba(121, 134, 203, 0.18) 0%, rgba(149, 117, 205, 0.1) 100%);
}

.hero-stat-value {
  color: #fffaf1;
  font-size: 28rpx;
  font-weight: 800;
}

.hero-stat-label {
  color: rgba(255, 250, 241, 0.72);
  font-size: 20rpx;
}

.panel-card {
  margin-top: 20rpx;
  border-radius: 32rpx;
  padding: 28rpx 26rpx;
  background: rgba(255, 251, 246, 0.94);
  box-shadow: 0 16rpx 38rpx rgba(28, 20, 10, 0.08);
}

.panel-head {
  margin-bottom: 24rpx;
}

.panel-title {
  display: block;
  color: #2f2418;
  font-size: 32rpx;
  font-weight: 800;
}

.panel-subtitle {
  display: block;
  margin-top: 10rpx;
  color: #8a7560;
  font-size: 23rpx;
  line-height: 1.7;
}

.field-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.field-item,
.switch-card {
  padding: 22rpx;
  border-radius: 24rpx;
  background: #f3eadf;
}

.field-label {
  display: block;
  margin-bottom: 14rpx;
  color: #6d5845;
  font-size: 24rpx;
  font-weight: 700;
}

.field-input {
  width: 100%;
  height: 68rpx;
  font-size: 28rpx;
  color: #2f2418;
}

.field-placeholder {
  color: #a3907a;
}

.location-btn {
  width: 100%;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  border: 2rpx dashed rgba(59, 76, 114, 0.28);
  background: linear-gradient(135deg, rgba(29, 39, 64, 0.06) 0%, rgba(58, 76, 114, 0.06) 100%);
  color: #44577f;
  font-size: 27rpx;
  font-weight: 700;
  text-align: center;
}

.location-btn::after,
.primary-btn::after {
  border: none;
}

.switch-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.switch-copy {
  flex: 1;
}

.switch-title {
  display: block;
  color: #2f2418;
  font-size: 28rpx;
  font-weight: 800;
}

.switch-desc {
  display: block;
  margin-top: 8rpx;
  color: #8a7560;
  font-size: 22rpx;
  line-height: 1.7;
}

.primary-btn {
  margin-top: 24rpx;
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: none;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1d2740 0%, #3b4c72 100%);
  color: #fff8ee;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  box-shadow: 0 18rpx 28rpx rgba(29, 39, 64, 0.18);
}
