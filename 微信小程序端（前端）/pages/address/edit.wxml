<!--pages/address/edit.wxml-->
<view class="address-edit-page">
  <view class="ambient ambient-1"></view>
  <view class="ambient ambient-2"></view>

  <admin-alert-overlay
    show="{{adminAlertOverlay.show}}"
    alert="{{adminAlertOverlay.alert}}"
    queueLength="{{adminAlertOverlay.queueLength}}"
    bind:later="onAdminAlertLater"
    bind:view="onAdminAlertView"
  />

  <scroll-view class="edit-scroll" scroll-y="{{true}}">
    <view class="edit-shell">
      <view class="hero-panel">
        <view class="hero-copy">
          <text class="hero-kicker">ADDRESS PROFILE</text>
          <text class="hero-title">{{isEdit ? '编辑收货地址' : '新建收货地址'}}</text>
          <text class="hero-subtitle">完善宿舍楼栋、房间号与定位信息，让配送更准确更顺畅。</text>
        </view>
        <view class="hero-stats">
          <view class="hero-stat warm-card">
            <text class="hero-stat-value">{{isEdit ? '编辑中' : '新地址'}}</text>
            <text class="hero-stat-label">当前状态</text>
          </view>
          <view class="hero-stat cool-card">
            <text class="hero-stat-value">{{isDefault === 1 ? '默认' : '普通'}}</text>
            <text class="hero-stat-label">地址类型</text>
          </view>
        </view>
      </view>

      <view class="panel-card">
        <view class="panel-head">
          <text class="panel-title">地址信息</text>
          <text class="panel-subtitle">请填写本次配送要使用的完整收货信息。</text>
        </view>

        <view class="field-list">
          <view class="field-item">
            <text class="field-label">收件人</text>
            <input class="field-input" type="text" placeholder="请输入收件人姓名" placeholder-class="field-placeholder" value="{{receiver}}" bindinput="onReceiverInput" />
          </view>

          <view class="field-item">
            <text class="field-label">手机号</text>
            <input class="field-input" type="number" placeholder="请输入手机号" placeholder-class="field-placeholder" value="{{phone}}" bindinput="onPhoneInput" />
          </view>

          <view class="field-item">
            <text class="field-label">楼栋</text>
            <input class="field-input" type="text" placeholder="请输入楼栋名称" placeholder-class="field-placeholder" value="{{building}}" bindinput="onBuildingInput" />
          </view>

          <view class="field-item">
            <text class="field-label">房间号</text>
            <input class="field-input" type="text" placeholder="请输入房间号" placeholder-class="field-placeholder" value="{{room}}" bindinput="onRoomInput" />
          </view>

          <view class="field-item">
            <text class="field-label">位置定位</text>
            <button class="location-btn" bindtap="onChooseLocation">{{latitude ? '已完成定位，点击重新选择' : '点击选择地图位置'}}</button>
          </view>

          <view class="switch-card">
            <view class="switch-copy">
              <text class="switch-title">设为默认地址</text>
              <text class="switch-desc">下单时会优先为你选中这个地址</text>
            </view>
            <switch checked="{{isDefault === 1}}" bindchange="onDefaultChange" color="#3b4c72" />
          </view>
        </view>
      </view>

      <button class="primary-btn" bindtap="onSave">保存地址</button>
    </view>
  </scroll-view>
</view>
