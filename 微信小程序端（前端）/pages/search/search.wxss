/* pages/search/search.wxss */
page {
  background: #f7f1e8;
  height: 100vh;
}

.search-page {
  min-height: 100vh;
  height: 100vh;
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at top left, rgba(255, 183, 77, 0.16) 0, rgba(255, 183, 77, 0) 34%),
    radial-gradient(circle at top right, rgba(77, 208, 225, 0.14) 0, rgba(77, 208, 225, 0) 30%),
    linear-gradient(180deg, #111827 0%, #182033 24%, #f6efe4 24%, #f7f1e8 100%);
}

.ambient {
  position: absolute;
  border-radius: 999rpx;
  filter: blur(42rpx);
  opacity: 0.56;
  pointer-events: none;
}

.ambient-1 {
  width: 260rpx;
  height: 260rpx;
  right: -40rpx;
  top: 90rpx;
  background: rgba(255, 167, 38, 0.22);
}

.ambient-2 {
  width: 320rpx;
  height: 320rpx;
  left: -120rpx;
  top: 260rpx;
  background: rgba(38, 198, 218, 0.18);
}

.search-shell {
  height: 100%;
  padding: 24rpx;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

.hero-panel {
  position: relative;
  overflow: hidden;
  border-radius: 34rpx;
  padding: 30rpx 28rpx;
  background: linear-gradient(135deg, rgba(18, 24, 39, 0.96) 0%, rgba(33, 41, 63, 0.92) 58%, rgba(79, 53, 34, 0.9) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 22rpx 60rpx rgba(8, 11, 20, 0.34);
}

.hero-panel::after {
  content: '';
  position: absolute;
  inset: 0;
  background:
    linear-gradient(120deg, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0) 24%),
    repeating-linear-gradient(90deg, rgba(255,255,255,0.03) 0 2rpx, transparent 2rpx 28rpx);
  pointer-events: none;
}

.hero-copy,
.search-bar {
  position: relative;
  z-index: 1;
}

.hero-copy {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hero-kicker {
  color: rgba(255, 224, 178, 0.78);
  font-size: 20rpx;
  letter-spacing: 6rpx;
}

.hero-title {
  color: #fff8ee;
  font-size: 50rpx;
  font-weight: 800;
  line-height: 1.18;
}

.hero-subtitle {
  color: rgba(255, 248, 238, 0.74);
  font-size: 24rpx;
  line-height: 1.7;
}

.search-bar {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  height: 82rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.search-icon,
.clear-icon {
  color: #ffe8c2;
  font-size: 28rpx;
}

.search-icon {
  margin-right: 12rpx;
}

.clear-icon {
  margin-left: 12rpx;
}

.search-input {
  flex: 1;
  height: 100%;
  color: #fff8ee;
  font-size: 28rpx;
}

.search-placeholder {
  color: rgba(255, 248, 238, 0.5);
}

.cancel-btn {
  color: #fff1da;
  font-size: 26rpx;
  font-weight: 700;
}

.search-result,
.search-suggest {
  margin-top: 20rpx;
  height: calc(100% - 258rpx);
}

.result-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tab-item {
  flex: 1;
  height: 72rpx;
  border-radius: 999rpx;
  background: rgba(255, 251, 246, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-item.active {
  background: linear-gradient(135deg, #1d2740 0%, #3b4c72 100%);
  box-shadow: 0 14rpx 24rpx rgba(29, 39, 64, 0.14);
}

.tab-text {
  color: #66513e;
  font-size: 24rpx;
  font-weight: 700;
}

.tab-item.active .tab-text {
  color: #fff8ee;
}

.panel-card,
.state-card {
  border-radius: 30rpx;
  padding: 26rpx;
  background: rgba(255, 251, 246, 0.94);
  box-shadow: 0 16rpx 38rpx rgba(28, 20, 10, 0.08);
  margin-bottom: 16rpx;
}

.state-card {
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.state-emoji {
  font-size: 84rpx;
  margin-bottom: 18rpx;
}

.state-title {
  color: #2f2418;
  font-size: 32rpx;
  font-weight: 800;
}

.state-desc {
  margin-top: 10rpx;
  color: #8a7560;
  font-size: 24rpx;
}

.result-list {
  height: calc(100% - 88rpx);
}

.result-section {
  margin-bottom: 16rpx;
}

.section-head {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.section-head.between {
  justify-content: space-between;
}

.section-title {
  color: #2f2418;
  font-size: 30rpx;
  font-weight: 800;
}

.clear-history {
  color: #8a7560;
  font-size: 24rpx;
}

.dish-list,
.canteen-list,
.suggest-list,
.history-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.dish-card,
.canteen-card,
.suggest-item,
.history-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 251, 246, 0.94);
  box-shadow: 0 12rpx 26rpx rgba(28, 20, 10, 0.06);
}

.dish-image,
.canteen-image {
  width: 116rpx;
  height: 116rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.dish-main,
.canteen-main,
.suggest-main {
  flex: 1;
  min-width: 0;
}

.dish-name,
.canteen-card-name,
.suggest-text,
.history-text {
  color: #2f2418;
  font-size: 28rpx;
  font-weight: 800;
}

.dish-desc,
.canteen-desc,
.canteen-location,
.suggest-count {
  display: block;
  margin-top: 8rpx;
  color: #8a7560;
  font-size: 22rpx;
  line-height: 1.6;
}

.dish-meta,
.dish-bottom {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.canteen-name,
.sales {
  color: #8a7560;
  font-size: 22rpx;
}

.price {
  color: #cf6518;
  font-size: 30rpx;
  font-weight: 800;
}

.add-btn {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1d2740 0%, #3b4c72 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-icon {
  color: #fff8ee;
  font-size: 34rpx;
  line-height: 1;
}

.arrow-icon,
.suggest-icon,
.history-icon {
  color: #b39f89;
  font-size: 28rpx;
  flex-shrink: 0;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tag-chip {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #f3eadf;
  color: #5f4b39;
  font-size: 24rpx;
  font-weight: 700;
}

.more-btn,
.no-more {
  margin: 16rpx 0 24rpx;
  text-align: center;
  color: #8a7560;
  font-size: 24rpx;
}
