/* pages/order/detail.wxss */
.detail-page {
  min-height: 100vh;
  height: 100vh;
  position: relative;
  background:
    radial-gradient(circle at top left, rgba(255, 183, 77, 0.18) 0, rgba(255, 183, 77, 0) 34%),
    radial-gradient(circle at top right, rgba(77, 208, 225, 0.14) 0, rgba(77, 208, 225, 0) 30%),
    linear-gradient(180deg, #111827 0%, #172033 28%, #f7efe4 28%, #f8f2ea 100%);
  overflow: hidden;
}

.ambient {
  position: absolute;
  border-radius: 999rpx;
  filter: blur(42rpx);
  opacity: 0.5;
  pointer-events: none;
}

.ambient-1 {
  width: 260rpx;
  height: 260rpx;
  right: -50rpx;
  top: 110rpx;
  background: rgba(255, 167, 38, 0.24);
}

.ambient-2 {
  width: 320rpx;
  height: 320rpx;
  left: -130rpx;
  top: 340rpx;
  background: rgba(38, 198, 218, 0.16);
}

.detail-scroll {
  height: 100%;
  position: relative;
  z-index: 1;
}

.detail-shell {
  padding: 28rpx 24rpx 228rpx;
}

.hero-panel {
  position: relative;
  overflow: hidden;
  padding: 34rpx 30rpx 30rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, rgba(18, 24, 39, 0.96) 0%, rgba(31, 41, 63, 0.93) 58%, rgba(83, 56, 37, 0.9) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 24rpx 60rpx rgba(8, 11, 20, 0.32);
}

.hero-panel.theme-pending {
  background: linear-gradient(135deg, rgba(61, 43, 20, 0.98) 0%, rgba(113, 69, 32, 0.94) 52%, rgba(210, 128, 54, 0.9) 100%);
}

.hero-panel.theme-paid {
  background: linear-gradient(135deg, rgba(28, 34, 58, 0.98) 0%, rgba(47, 61, 96, 0.94) 52%, rgba(103, 122, 189, 0.88) 100%);
}

.hero-panel.theme-making {
  background: linear-gradient(135deg, rgba(34, 22, 54, 0.98) 0%, rgba(67, 44, 98, 0.94) 50%, rgba(136, 87, 194, 0.88) 100%);
}

.hero-panel.theme-ready {
  background: linear-gradient(135deg, rgba(20, 51, 54, 0.98) 0%, rgba(27, 87, 84, 0.94) 50%, rgba(74, 190, 167, 0.88) 100%);
}

.hero-panel.theme-delivery {
  background: linear-gradient(135deg, rgba(18, 44, 61, 0.98) 0%, rgba(26, 79, 111, 0.94) 52%, rgba(71, 155, 223, 0.88) 100%);
}

.hero-panel.theme-success {
  background: linear-gradient(135deg, rgba(22, 52, 39, 0.98) 0%, rgba(29, 100, 73, 0.94) 52%, rgba(77, 194, 132, 0.88) 100%);
}

.hero-panel.theme-cancel {
  background: linear-gradient(135deg, rgba(38, 41, 49, 0.98) 0%, rgba(69, 75, 89, 0.94) 52%, rgba(126, 134, 148, 0.86) 100%);
}

.hero-panel::after {
  content: '';
  position: absolute;
  inset: 0;
  background:
    linear-gradient(120deg, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0) 24%),
    repeating-linear-gradient(90deg, rgba(255,255,255,0.03) 0 2rpx, transparent 2rpx 28rpx);
  pointer-events: none;
}

.hero-head,
.hero-meta-row,
.pickup-card,
.progress-card {
  position: relative;
  z-index: 1;
}

.hero-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 22rpx;
}

.hero-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hero-kicker {
  color: rgba(255, 224, 178, 0.76);
  font-size: 20rpx;
  letter-spacing: 6rpx;
}

.hero-title {
  color: #fff8ef;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.25;
}

.hero-desc {
  color: rgba(255, 248, 239, 0.72);
  font-size: 24rpx;
  line-height: 1.72;
}

  .hero-icon-wrap {
  width: 108rpx;
  height: 108rpx;
  flex-shrink: 0;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.08);
}

.hero-icon-wrap.clickable {
  cursor: pointer;
}

.hero-icon-wrap.clickable:active {
  transform: scale(0.96);
  background: rgba(255, 255, 255, 0.16);
}

.hero-icon {
  color: #fff6e8;
  font-size: 52rpx;
  line-height: 1;
}

.hero-meta-row {
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}

.status-chip,
.pay-chip {
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: #fff7ea;
}

.status-chip {
  background: rgba(255, 255, 255, 0.12);
}

.status-chip-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ffb74d;
}

.pay-chip {
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 247, 234, 0.8);
}

.pay-chip.paid {
  background: rgba(111, 231, 183, 0.14);
  color: #d8fff0;
}

.pickup-card {
  margin-top: 24rpx;
  padding: 24rpx 24rpx;
  border-radius: 26rpx;
  background: rgba(255, 248, 239, 0.1);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.pickup-card-strong {
  padding: 30rpx 28rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(255, 244, 214, 0.2) 0%, rgba(255, 255, 255, 0.08) 100%);
  box-shadow: inset 0 0 0 1rpx rgba(255, 248, 239, 0.16), 0 16rpx 34rpx rgba(9, 23, 23, 0.18);
}

.pickup-card-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.pickup-spotlight-label {
  color: rgba(255, 249, 240, 0.72);
  font-size: 20rpx;
  letter-spacing: 6rpx;
}

.pickup-spotlight-code {
  margin-top: 12rpx;
  color: #fffdfa;
  font-size: 58rpx;
  font-weight: 800;
  letter-spacing: 10rpx;
  line-height: 1.05;
}

.pickup-spotlight-tip {
  margin-top: 14rpx;
  color: rgba(255, 248, 239, 0.78);
  font-size: 22rpx;
  line-height: 1.7;
}

.pickup-label {
  display: block;
  color: rgba(255, 247, 234, 0.68);
  font-size: 22rpx;
}

.pickup-code {
  display: block;
  margin-top: 8rpx;
  color: #fff9f0;
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.pickup-copy {
  min-width: 120rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #fff8ee;
  font-size: 22rpx;
}

.pickup-copy-strong {
  min-width: 156rpx;
  height: 72rpx;
  padding: 0 22rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 24rpx;
  font-weight: 700;
}

.progress-card {
  margin-top: 26rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.08);
}

.progress-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.progress-title {
  color: #fff8ef;
  font-size: 24rpx;
  font-weight: 700;
}

.progress-value {
  color: rgba(255, 248, 239, 0.76);
  font-size: 22rpx;
}

.progress-track {
  position: relative;
  height: 10rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #ffb74d 0%, #71e7b7 100%);
}

.progress-steps {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
}

.progress-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  text-align: center;
}

.progress-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #101826;
  font-size: 16rpx;
  font-weight: 700;
}

.progress-step.active .progress-dot,
.progress-step.current .progress-dot {
  background: #fff3d9;
}

.progress-label {
  color: rgba(255, 248, 239, 0.72);
  font-size: 20rpx;
  line-height: 1.45;
}

.progress-step.active .progress-label,
.progress-step.current .progress-label {
  color: #fff9f0;
}

.info-grid,
.items-card,
.timeline-card,
.cancel-card,
.detail-card {
  margin-top: 20rpx;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.glass-card {
  border-radius: 30rpx;
  padding: 28rpx 26rpx;
  background: rgba(255, 251, 246, 0.94);
  box-shadow: 0 16rpx 38rpx rgba(28, 20, 10, 0.08);
}

.card-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.card-title {
  color: #2f2418;
  font-size: 30rpx;
  font-weight: 800;
}

.card-subtitle,
.shop-meta {
  color: #8a7560;
  font-size: 22rpx;
  line-height: 1.7;
}

.shop-name {
  display: block;
  color: #2f2418;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.mini-action {
  min-width: 100rpx;
  height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1f2937 0%, #6b4a33 100%);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #fff8ef;
  font-size: 20rpx;
}

.amount-highlight {
  color: #5f3d2b;
  font-size: 34rpx;
  font-weight: 800;
}

.amount-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  color: #6f604f;
  font-size: 24rpx;
}

.amount-line.total {
  color: #2f2418;
  font-size: 28rpx;
  font-weight: 800;
}

.discount-text {
  color: #2f9c74;
}

.amount-divider {
  height: 1rpx;
  margin: 14rpx 0;
  background: rgba(111, 96, 79, 0.12);
}

.item-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(111, 96, 79, 0.1);
}

.item-row.with-image {
  align-items: center;
}

.item-image {
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  background: #efe5d8;
  box-shadow: 0 10rpx 22rpx rgba(41, 28, 18, 0.08);
}

.item-row:last-child {
  padding-bottom: 0;
  border-bottom: none;
}

.item-main {
  flex: 1;
}

.item-name {
  display: block;
  color: #2f2418;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.5;
}

.item-spec,
.item-remark {
  display: block;
  margin-top: 8rpx;
  color: #8a7560;
  font-size: 22rpx;
  line-height: 1.6;
}

.item-total {
  color: #5f3d2b;
  font-size: 28rpx;
  font-weight: 800;
}

.timeline-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.timeline-item {
  display: flex;
  gap: 16rpx;
}

.timeline-axis {
  width: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.timeline-node {
  width: 18rpx;
  height: 18rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: #dacdbd;
  box-shadow: 0 0 0 8rpx rgba(218, 205, 189, 0.22);
}

.timeline-node.active {
  background: #5f3d2b;
  box-shadow: 0 0 0 8rpx rgba(95, 61, 43, 0.12);
}

.timeline-stick {
  flex: 1;
  width: 2rpx;
  margin-top: 12rpx;
  background: rgba(138, 117, 96, 0.22);
}

.timeline-body {
  flex: 1;
  padding: 4rpx 0 28rpx;
}

.timeline-item:last-child .timeline-body {
  padding-bottom: 0;
}

.timeline-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 14rpx;
}

.timeline-status {
  color: #2f2418;
  font-size: 26rpx;
  font-weight: 700;
}

.timeline-time,
.timeline-operator {
  color: #8a7560;
  font-size: 21rpx;
}

.timeline-desc {
  display: block;
  margin-top: 10rpx;
  color: #6f604f;
  font-size: 23rpx;
  line-height: 1.7;
}

.cancel-reason-text {
  display: block;
  color: #6b5643;
  font-size: 24rpx;
  line-height: 1.85;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(118, 127, 146, 0.1) 0%, rgba(179, 151, 120, 0.08) 100%);
  border: 1rpx solid rgba(118, 127, 146, 0.1);
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(111, 96, 79, 0.1);
}

.detail-row:last-child {
  padding-bottom: 0;
  border-bottom: none;
}

.detail-label {
  color: #8a7560;
  font-size: 24rpx;
}

.detail-value {
  flex: 1;
  text-align: right;
  color: #2f2418;
  font-size: 24rpx;
  line-height: 1.7;
}

.detail-value.multiline {
  white-space: normal;
}

.detail-mono {
  font-family: 'Consolas', 'Menlo', monospace;
}

.loading-shell {
  padding: 40rpx 24rpx 220rpx;
}

.loading-card {
  border-radius: 32rpx;
  padding: 80rpx 36rpx;
  background: rgba(255, 251, 246, 0.94);
  box-shadow: 0 18rpx 40rpx rgba(28, 20, 10, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.loading-orb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #1f2937 0%, #6b4a33 100%);
  opacity: 0.88;
}

.loading-title {
  margin-top: 24rpx;
  color: #2f2418;
  font-size: 34rpx;
  font-weight: 700;
}

.loading-desc {
  margin-top: 14rpx;
  color: #8a7560;
  font-size: 24rpx;
  line-height: 1.7;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 6;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(248, 242, 234, 0.88);
  backdrop-filter: blur(18rpx);
  box-shadow: 0 -8rpx 30rpx rgba(20, 18, 14, 0.08);
}

.action-stack {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.action-stack.single {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.action-stack.wrap {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.action-btn {
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 700;
  padding: 0;
  margin: 0;
  border: none;
}

.action-btn::after {
  border: none;
}

.action-btn.primary {
  color: #fff8ef;
  background: linear-gradient(135deg, #1f2937 0%, #6b4a33 100%);
  box-shadow: 0 12rpx 24rpx rgba(47, 36, 24, 0.18);
}

.action-btn.secondary {
  color: #4d3b2b;
  background: rgba(255, 251, 246, 0.96);
  box-shadow: inset 0 0 0 1rpx rgba(95, 61, 43, 0.08);
}

.action-btn.disabled {
  opacity: 0.56;
}

@media (max-width: 520px) {
  .info-grid {
    grid-template-columns: 1fr;
  }

  .hero-title {
    font-size: 40rpx;
}

  .progress-steps {
    gap: 6rpx;
  }

  .progress-label {
    font-size: 18rpx;
  }
}
