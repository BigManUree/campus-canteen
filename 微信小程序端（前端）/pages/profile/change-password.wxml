<!--pages/profile/change-password.wxml-->
<view class="password-page">
  <view class="ambient ambient-1"></view>
  <view class="ambient ambient-2"></view>

  <scroll-view class="password-scroll" scroll-y="{{true}}">
    <view class="password-shell">
      <view class="hero-panel">
        <view class="hero-copy">
          <text class="hero-kicker">SECURITY CENTER</text>
          <text class="hero-title">修改登录密码</text>
          <text class="hero-subtitle">为了账户安全，请使用足够复杂的新密码，并妥善保管。</text>
        </view>
      </view>

      <view class="panel-card">
        <view class="panel-head">
          <text class="panel-title">密码信息</text>
          <text class="panel-subtitle">输入旧密码后，设置新的登录密码完成更新。</text>
        </view>

        <view class="field-list">
          <view class="field-item">
            <text class="field-label">旧密码</text>
            <view class="password-row">
              <input class="field-input password-input" password="{{!showOldPassword}}" placeholder="请输入旧密码" placeholder-class="field-placeholder" value="{{oldPassword}}" bindinput="onOldPasswordInput" />
              <text class="toggle-eye" bindtap="toggleOldPassword">👁</text>
            </view>
          </view>

          <view class="field-item">
            <text class="field-label">新密码</text>
            <view class="password-row">
              <input class="field-input password-input" password="{{!showNewPassword}}" placeholder="请输入新密码（至少6位）" placeholder-class="field-placeholder" value="{{newPassword}}" bindinput="onNewPasswordInput" />
              <text class="toggle-eye" bindtap="toggleNewPassword">👁</text>
            </view>
          </view>

          <view class="field-item">
            <text class="field-label">确认密码</text>
            <view class="password-row">
              <input class="field-input password-input" password="{{!showConfirmPassword}}" placeholder="请再次输入新密码" placeholder-class="field-placeholder" value="{{confirmPassword}}" bindinput="onConfirmPasswordInput" />
              <text class="toggle-eye" bindtap="toggleConfirmPassword">👁</text>
            </view>
          </view>
        </view>
      </view>

      <button class="primary-btn" bindtap="onSubmit">确认修改</button>
    </view>
  </scroll-view>
</view>
