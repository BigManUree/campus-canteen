/* pages/media/media.wxss */
page {
  background: #f7f1e8;
  min-height: 100vh;
}

.media-page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at top left, rgba(255, 183, 77, 0.16) 0, rgba(255, 183, 77, 0) 34%),
    radial-gradient(circle at top right, rgba(77, 208, 225, 0.14) 0, rgba(77, 208, 225, 0) 30%),
    linear-gradient(180deg, #111827 0%, #182033 24%, #f6efe4 24%, #f7f1e8 100%);
}

.media-shell {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.media-header {
  position: relative;
  overflow: hidden;
  padding: 30rpx 28rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, rgba(18, 24, 39, 0.96) 0%, rgba(33, 41, 63, 0.92) 58%, rgba(79, 53, 34, 0.9) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 22rpx 60rpx rgba(8, 11, 20, 0.34);
}

.media-header::after {
  content: '';
  position: absolute;
  inset: 0;
  background:
    linear-gradient(120deg, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0) 24%),
    repeating-linear-gradient(90deg, rgba(255,255,255,0.03) 0 2rpx, transparent 2rpx 28rpx);
  pointer-events: none;
}

.media-badge,
.media-title,
.media-desc {
  position: relative;
  z-index: 1;
}

.media-badge {
  display: inline-flex;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  color: rgba(255, 224, 178, 0.82);
  font-size: 22rpx;
  margin-bottom: 18rpx;
  letter-spacing: 2rpx;
}

.media-title {
  display: block;
  color: #fff8ee;
  font-size: 46rpx;
  font-weight: 800;
}

.media-desc {
  display: block;
  color: rgba(255, 248, 238, 0.74);
  font-size: 24rpx;
  margin-top: 12rpx;
  line-height: 1.7;
}

.media-card,
.state-card,
.tips-card,
.debug-card {
  background: rgba(255, 251, 246, 0.94);
  border-radius: 32rpx;
  box-shadow: 0 16rpx 38rpx rgba(28, 20, 10, 0.08);
  overflow: hidden;
}

.media-player {
  width: 100%;
  height: 420rpx;
  background: #000;
}

.audio-panel {
  padding: 56rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.audio-icon {
  font-size: 88rpx;
  margin-bottom: 22rpx;
}

.audio-title {
  color: #2f2418;
  font-size: 34rpx;
  font-weight: 700;
}

.audio-url {
  color: #8a7560;
  font-size: 24rpx;
  margin-top: 18rpx;
  word-break: break-all;
  line-height: 1.6;
}

.audio-btn {
  margin-top: 32rpx;
  width: 280rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: none;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1d2740 0%, #3b4c72 100%);
  color: #fff8ee;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
}

.state-card,
.tips-card,
.debug-card {
  padding: 32rpx;
}

.state-title,
.tips-title,
.debug-title {
  display: block;
  color: #2f2418;
  font-size: 30rpx;
  font-weight: 800;
}

.state-desc,
.tips-item,
.debug-tip {
  display: block;
  color: #8a7560;
  font-size: 24rpx;
  line-height: 1.8;
  margin-top: 16rpx;
}

.debug-url {
  display: block;
  color: #3b4c72;
  font-size: 22rpx;
  line-height: 1.8;
  margin-top: 16rpx;
  word-break: break-all;
}

.audio-btn::after {
  border: none;
}
