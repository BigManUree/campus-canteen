<!--pages/favorite/favorite.wxml-->
<view class="favorite-page">
  <view class="ambient ambient-1"></view>
  <view class="ambient ambient-2"></view>

  <admin-alert-overlay
    show="{{adminAlertOverlay.show}}"
    alert="{{adminAlertOverlay.alert}}"
    queueLength="{{adminAlertOverlay.queueLength}}"
    bind:later="onAdminAlertLater"
    bind:view="onAdminAlertView"
  />

  <scroll-view 
    class="favorite-scroll" 
    scroll-y="{{true}}"
    bindscrolltolower="loadMore"
    lower-threshold="{{100}}"
    enhanced
  >
    <view class="favorite-shell">
      <view class="hero-panel">
        <view class="hero-copy">
          <text class="hero-kicker">CURATED BOARD</text>
          <text class="hero-title">我的收藏</text>
          <text class="hero-subtitle">把喜欢的菜品集中收好，想吃的时候能更快找到它们。</text>
        </view>

        <view class="hero-stats">
          <view class="hero-stat warm-card">
            <text class="hero-stat-value">{{allFavorites.length}}</text>
            <text class="hero-stat-label">全部收藏</text>
          </view>
          <view class="hero-stat cool-card">
            <text class="hero-stat-value">{{favorites.length}}</text>
            <text class="hero-stat-label">当前展示</text>
          </view>
          <view class="hero-stat mint-card">
            <text class="hero-stat-value">{{hasMore ? '···' : 'OK'}}</text>
            <text class="hero-stat-label">加载状态</text>
          </view>
        </view>
      </view>

      <view class="section-bar" wx:if="{{!loading && favorites.length > 0}}">
        <view>
          <text class="section-title">收藏清单</text>
          <text class="section-desc">点击卡片进入详情，右上角可直接取消收藏</text>
        </view>
        <view class="section-pill">
          <text>{{favorites.length}} 件</text>
        </view>
      </view>

      <!-- 骨架屏 -->
      <view class="favorites-grid" wx:if="{{loading}}">
        <view class="favorite-card skeleton" wx:for="{{[1,2,3,4]}}" wx:key="*this">
          <view class="card-image skeleton-img"></view>
          <view class="card-body">
            <view class="skeleton-line w80"></view>
            <view class="skeleton-line w60"></view>
            <view class="skeleton-line w40"></view>
          </view>
        </view>
      </view>

      <!-- 收藏卡片 -->
      <view class="favorites-grid" wx:if="{{!loading && favorites.length > 0}}">
        <view 
          class="favorite-card" 
          wx:for="{{favorites}}" 
          wx:key="favorite_id"
        >
          <view 
            class="delete-btn" 
            catchtap="onRemoveFavorite" 
            data-dish-id="{{item.dish_id}}"
          >
            <text class="delete-icon">✕</text>
          </view>

          <view class="card-content" bindtap="onDishTap" data-id="{{item.dish_id}}">
            <view class="card-image-wrap">
              <image class="card-image" src="{{item.cover_url}}" mode="aspectFill" lazy-load />
              <view class="image-overlay"></view>
              <view class="favorite-chip">
                <text class="chip-heart">♥</text>
                <text class="chip-text">已收藏</text>
              </view>
            </view>

            <view class="card-body">
              <text class="dish-name">{{item.dish_name}}</text>
              <view class="card-meta-row">
                <view class="price-box">
                  <text class="price-symbol">¥</text>
                  <text class="price-value">{{item.dish_price}}</text>
                </view>
                <view class="detail-hint">
                  <text>查看详情</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 加载更多 -->
      <view class="load-more" wx:if="{{!loading && favorites.length > 0}}">
        <view class="loading-spinner" wx:if="{{loadingMore}}"></view>
        <text class="load-text" wx:if="{{loadingMore}}">正在继续整理收藏...</text>
        <text class="load-text" wx:elif="{{hasMore}}">上滑加载更多收藏</text>
        <text class="load-text end" wx:else>已经到底啦，收藏都在这里</text>
      </view>

      <!-- 空状态 -->
      <view class="state-panel" wx:if="{{!loading && !error && favorites.length === 0}}">
        <view class="state-icon warm">♥</view>
        <text class="state-title">还没有收藏菜品</text>
        <text class="state-desc">先去逛逛菜单，把真正想回购的美食留在这里吧。</text>
        <navigator url="/pages/index/index" open-type="switchTab" class="state-btn">
          <text>去逛逛</text>
        </navigator>
      </view>

      <!-- 错误状态 -->
      <view class="state-panel" wx:if="{{!loading && error}}">
        <view class="state-icon cool">!</view>
        <text class="state-title">收藏加载失败</text>
        <text class="state-desc">网络好像有点不稳定，重新试一次看看。</text>
        <view class="state-btn" bindtap="onRetry">
          <text>重新加载</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
