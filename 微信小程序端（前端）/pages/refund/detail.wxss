/* pages/refund/detail.wxss */
.refund-detail-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top right, rgba(124, 92, 255, 0.18), transparent 32%),
    radial-gradient(circle at top left, rgba(255, 146, 43, 0.16), transparent 28%),
    linear-gradient(180deg, #f8f9ff 0%, #eef2ff 46%, #f6f7fb 100%);
}

.loading-wrap {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.loading-spinner {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  border: 8rpx solid rgba(92, 124, 250, 0.14);
  border-top-color: #5c7cfa;
  animation: spin 1s linear infinite;
}

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #5f6b7a;
}

.detail-scroll {
  height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.hero-card {
  padding: 34rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(24, 28, 51, 0.92), rgba(74, 35, 90, 0.9));
  box-shadow: 0 24rpx 56rpx rgba(55, 65, 81, 0.18);
  color: #fff;
  margin-bottom: 24rpx;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.hero-title {
  font-size: 34rpx;
  font-weight: 700;
}

.status-pill {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  background: rgba(255,255,255,0.14);
}

.refund-no,
.refund-time {
  display: block;
  font-size: 25rpx;
  color: rgba(255,255,255,0.8);
}

.refund-amount {
  display: block;
  margin: 18rpx 0 14rpx;
  font-size: 60rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.panel {
  background: rgba(255,255,255,0.88);
  backdrop-filter: blur(12rpx);
  border: 1rpx solid rgba(124, 92, 255, 0.08);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 10rpx 28rpx rgba(117, 126, 177, 0.08);
}

.panel-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #25324a;
  margin-bottom: 22rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.7);
}

.info-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.label {
  font-size: 26rpx;
  color: #7b8794;
}

.value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 600;
}

.value.link {
  color: #5c7cfa;
}

.value.multiline {
  white-space: normal;
  line-height: 1.7;
}

.info-block {
  padding: 6rpx 0 2rpx;
}

.reason-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: #2d3748;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

