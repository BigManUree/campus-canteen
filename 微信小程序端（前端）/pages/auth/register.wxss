/* pages/auth/register.wxss */
page {
  background: #f7f1e8;
  height: 100vh;
}

.container {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at top left, rgba(255, 183, 77, 0.16) 0, rgba(255, 183, 77, 0) 34%),
    radial-gradient(circle at top right, rgba(77, 208, 225, 0.14) 0, rgba(77, 208, 225, 0) 30%),
    linear-gradient(180deg, #111827 0%, #182033 28%, #f6efe4 28%, #f7f1e8 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 84rpx 24rpx 56rpx;
  box-sizing: border-box;
}

.container::before,
.container::after {
  content: '';
  position: absolute;
  border-radius: 999rpx;
  filter: blur(42rpx);
  opacity: 0.56;
  pointer-events: none;
}

.container::before {
  width: 260rpx;
  height: 260rpx;
  right: -40rpx;
  top: 90rpx;
  background: rgba(255, 167, 38, 0.22);
}

.container::after {
  width: 320rpx;
  height: 320rpx;
  left: -120rpx;
  top: 260rpx;
  background: rgba(38, 198, 218, 0.18);
}

.register-header,
.register-form {
  position: relative;
  z-index: 1;
  width: 100%;
}

.register-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 32rpx 28rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, rgba(18, 24, 39, 0.96) 0%, rgba(33, 41, 63, 0.92) 58%, rgba(79, 53, 34, 0.9) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 22rpx 60rpx rgba(8, 11, 20, 0.34);
  box-sizing: border-box;
  overflow: hidden;
}

.register-header::after {
  content: '';
  position: absolute;
  inset: 0;
  background:
    linear-gradient(120deg, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0) 24%),
    repeating-linear-gradient(90deg, rgba(255,255,255,0.03) 0 2rpx, transparent 2rpx 28rpx);
  pointer-events: none;
}

.title,
.subtitle {
  position: relative;
  z-index: 1;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
  color: #fff8ee;
  margin-bottom: 14rpx;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255, 248, 238, 0.76);
}

.register-form {
  background: rgba(255, 251, 246, 0.94);
  border-radius: 32rpx;
  padding: 34rpx 26rpx;
  box-shadow: 0 16rpx 38rpx rgba(28, 20, 10, 0.08);
  box-sizing: border-box;
  overflow: hidden;
}

.form-item {
  margin-bottom: 18rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #f3eadf;
}

.form-label {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
  font-size: 24rpx;
  color: #6d5845;
  font-weight: 700;
}

.label-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.form-input {
  width: 100%;
  height: 68rpx;
  padding: 0;
  box-sizing: border-box;
  background: transparent;
  border-radius: 0;
  font-size: 28rpx;
  color: #2f2418;
}

.form-input::placeholder {
  color: #a3907a;
}

.password-input-wrapper {
  position: relative;
  width: 100%;
  display: flex;
  align-items: center;
}

.password-input-wrapper .form-input {
  padding-right: 68rpx;
}

.toggle-password {
  position: absolute;
  right: 4rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 0.1;
  color: #8c775f;
}

.register-btn {
  width: 100%;
  height: 88rpx;
  margin-top: 28rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: none;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1d2740 0%, #3b4c72 100%);
  color: #fff8ee;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  box-shadow: 0 18rpx 28rpx rgba(29, 39, 64, 0.18);
}

.register-btn::after {
  border: none;
}

.login-link {
  text-align: center;
  font-size: 26rpx;
  color: #8a7560;
}

.link-text {
  color: #3b4c72;
  margin-left: 10rpx;
  font-weight: 700;
}
