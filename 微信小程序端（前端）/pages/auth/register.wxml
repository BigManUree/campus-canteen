<!--pages/auth/register.wxml-->
<view class="container">
  <view class="register-header">
    <text class="title">注册账号</text>
    <text class="subtitle">创建您的账户</text>
  </view>

  <view class="register-form">
    <view class="form-item">
      <view class="form-label">
        <text class="label-icon">👤</text>
        <text>用户名/学号</text>
      </view>
      <input 
        class="form-input" 
        type="text" 
        placeholder="请输入用户名或学号" 
        value="{{username}}"
        bindinput="onUsernameInput"
      />
    </view>

    <view class="form-item">
      <view class="form-label">
        <text class="label-icon">🔒</text>
        <text>密码</text>
      </view>
      <view class="password-input-wrapper">
        <input 
          class="form-input" 
          password="{{!showPassword}}"
          placeholder="至少6位密码" 
          value="{{password}}"
          bindinput="onPasswordInput"
        />
        <text class="toggle-password" bindtap="togglePassword">
          {{showPassword ? '👁' : '👁'}}
        </text>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">
        <text class="label-icon">🔒</text>
        <text>确认密码</text>
      </view>
      <view class="password-input-wrapper">
        <input 
          class="form-input" 
          password="{{!showConfirmPassword}}"
          placeholder="请再次输入密码" 
          value="{{confirmPassword}}"
          bindinput="onConfirmPasswordInput"
        />
        <text class="toggle-password" bindtap="toggleConfirmPassword">
          {{showConfirmPassword ? '👁' : '👁'}}
        </text>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">
        <text class="label-icon">📱</text>
        <text>手机号（可选）</text>
      </view>
      <input 
        class="form-input" 
        type="number" 
        placeholder="请输入手机号" 
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>

    <view class="form-item">
      <view class="form-label">
        <text class="label-icon">✏️</text>
        <text>昵称（可选）</text>
      </view>
      <input 
        class="form-input" 
        type="text" 
        placeholder="请输入昵称" 
        value="{{nickname}}"
        bindinput="onNicknameInput"
      />
    </view>

    <button class="btn btn-primary register-btn" bindtap="onRegister">注册</button>

    <view class="login-link">
      <text>已有账号？</text>
      <text class="link-text" bindtap="onLogin">立即登录</text>
    </view>
  </view>
</view>

