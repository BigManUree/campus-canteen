/* pages/auth/forgot-password.wxss */
page {
  background: #f7f1e8;
  height: 100vh;
}

.reset-page {
  min-height: 100vh;
  height: 100vh;
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at top left, rgba(255, 183, 77, 0.16) 0, rgba(255, 183, 77, 0) 34%),
    radial-gradient(circle at top right, rgba(77, 208, 225, 0.14) 0, rgba(77, 208, 225, 0) 30%),
    linear-gradient(180deg, #111827 0%, #182033 24%, #f6efe4 24%, #f7f1e8 100%);
}

.ambient {
  position: absolute;
  border-radius: 999rpx;
  filter: blur(42rpx);
  opacity: 0.56;
  pointer-events: none;
}

.ambient-1 {
  width: 260rpx;
  height: 260rpx;
  right: -40rpx;
  top: 90rpx;
  background: rgba(255, 167, 38, 0.22);
}

.ambient-2 {
  width: 320rpx;
  height: 320rpx;
  left: -120rpx;
  top: 260rpx;
  background: rgba(38, 198, 218, 0.18);
}

.reset-scroll {
  height: 100%;
  position: relative;
  z-index: 1;
}

.reset-shell {
  padding: 28rpx 24rpx 56rpx;
}

.hero-panel,
.panel-card {
  border-radius: 34rpx;
  overflow: hidden;
}

.hero-panel {
  position: relative;
  padding: 30rpx 28rpx;
  background: linear-gradient(135deg, rgba(18, 24, 39, 0.96) 0%, rgba(33, 41, 63, 0.92) 58%, rgba(79, 53, 34, 0.9) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 22rpx 60rpx rgba(8, 11, 20, 0.34);
}

.hero-panel::after {
  content: '';
  position: absolute;
  inset: 0;
  background:
    linear-gradient(120deg, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0) 24%),
    repeating-linear-gradient(90deg, rgba(255,255,255,0.03) 0 2rpx, transparent 2rpx 28rpx);
  pointer-events: none;
}

.hero-copy,
.hero-steps {
  position: relative;
  z-index: 1;
}

.hero-copy {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hero-kicker {
  color: rgba(255, 224, 178, 0.78);
  font-size: 20rpx;
  letter-spacing: 6rpx;
}

.hero-title {
  color: #fff8ee;
  font-size: 50rpx;
  font-weight: 800;
  line-height: 1.18;
}

.hero-subtitle {
  color: rgba(255, 248, 238, 0.74);
  font-size: 24rpx;
  line-height: 1.7;
}

.hero-steps {
  margin-top: 24rpx;
  display: flex;
  gap: 12rpx;
}

.step-chip {
  flex: 1;
  min-height: 92rpx;
  border-radius: 20rpx;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.step-chip.active {
  background: linear-gradient(135deg, rgba(255, 183, 77, 0.18) 0%, rgba(255, 167, 38, 0.1) 100%);
}

.step-index {
  color: #fffaf1;
  font-size: 30rpx;
  font-weight: 800;
}

.step-text {
  color: rgba(255, 250, 241, 0.74);
  font-size: 20rpx;
}

.panel-card {
  margin-top: 20rpx;
  padding: 28rpx 26rpx;
  background: rgba(255, 251, 246, 0.94);
  box-shadow: 0 16rpx 38rpx rgba(28, 20, 10, 0.08);
}

.panel-head {
  margin-bottom: 24rpx;
}

.panel-title {
  display: block;
  color: #2f2418;
  font-size: 32rpx;
  font-weight: 800;
}

.panel-subtitle {
  display: block;
  margin-top: 10rpx;
  color: #8a7560;
  font-size: 23rpx;
  line-height: 1.7;
}

.field-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.field-item {
  padding: 22rpx;
  border-radius: 24rpx;
  background: #f3eadf;
}

.field-item.readonly {
  opacity: 0.86;
}

.field-label {
  display: block;
  margin-bottom: 14rpx;
  color: #6d5845;
  font-size: 24rpx;
  font-weight: 700;
}

.field-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.field-label-row .field-label {
  margin-bottom: 0;
}

.field-action {
  color: #42557f;
  font-size: 22rpx;
  font-weight: 700;
}

.field-input {
  width: 100%;
  height: 68rpx;
  font-size: 28rpx;
  color: #2f2418;
}

.field-placeholder {
  color: #a3907a;
}

.field-tip {
  display: block;
  margin-top: 12rpx;
  color: #b0564c;
  font-size: 21rpx;
  line-height: 1.6;
}

.field-tip {
  display: block;
  margin-top: 12rpx;
  color: #b76428;
  font-size: 22rpx;
}

.password-row {
  position: relative;
  display: flex;
  align-items: center;
}

.password-input {
  padding-right: 68rpx;
  box-sizing: border-box;
}

.toggle-eye {
  position: absolute;
  right: 4rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 34rpx;
  color: #8c775f;
}

.primary-btn {
  margin-top: 28rpx;
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: none;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1d2740 0%, #3b4c72 100%);
  color: #fff8ee;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  box-shadow: 0 18rpx 28rpx rgba(29, 39, 64, 0.18);
}

.primary-btn::after {
  border: none;
}
