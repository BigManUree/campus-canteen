<!--pages/auth/forgot-password.wxml-->
<view class="reset-page">
  <view class="ambient ambient-1"></view>
  <view class="ambient ambient-2"></view>

  <scroll-view class="reset-scroll" scroll-y="{{true}}">
    <view class="reset-shell">
      <view class="hero-panel">
        <view class="hero-copy">
          <text class="hero-kicker">ACCOUNT RECOVERY</text>
          <text class="hero-title">找回你的账号密码</text>
          <text class="hero-subtitle">按步骤完成身份确认与密码重置，重新回到你的校园点餐账户。</text>
        </view>
        <view class="hero-steps">
          <view class="step-chip {{step >= 1 ? 'active' : ''}}">
            <text class="step-index">01</text>
            <text class="step-text">验证账号</text>
          </view>
          <view class="step-chip {{step >= 2 ? 'active' : ''}}">
            <text class="step-index">02</text>
            <text class="step-text">设置新密码</text>
          </view>
        </view>
      </view>

      <view class="panel-card" wx:if="{{step === 1}}">
        <view class="panel-head">
          <text class="panel-title">发送验证码</text>
          <text class="panel-subtitle">请输入手机号，我们会发送验证码用于确认身份。</text>
        </view>

        <view class="field-list">
          <view class="field-item">
            <text class="field-label">用户名 / 手机号</text>
            <input
              class="field-input"
              type="text"
              placeholder="请输入用户名或手机号"
              placeholder-class="field-placeholder"
              value="{{username}}"
              bindinput="onUsernameInput"
            />
          </view>
        </view>

        <button class="primary-btn" bindtap="onSendCode" disabled="{{sendingCode || countdown > 0}}">
          {{countdown > 0 ? countdown + '秒后重发' : (sendingCode ? '发送中...' : '发送验证码')}}
        </button>
      </view>

      <view class="panel-card" wx:if="{{step === 2}}">
        <view class="panel-head">
          <text class="panel-title">重置密码</text>
          <text class="panel-subtitle">输入验证码并设置新的登录密码。</text>
        </view>

        <view class="field-list">
          <view class="field-item readonly">
            <text class="field-label">用户名 / 手机号</text>
            <input
              class="field-input"
              type="text"
              value="{{username}}"
              disabled
            />
          </view>

          <view class="field-item">
            <view class="field-label-row">
              <text class="field-label">验证码</text>
              <text class="field-action" bindtap="onSendCode">{{countdown > 0 ? countdown + '秒后重发' : '重新发送'}}</text>
            </view>
            <input
              class="field-input"
              type="number"
              placeholder="请输入验证码"
              placeholder-class="field-placeholder"
              value="{{code}}"
              bindinput="onCodeInput"
              maxlength="6"
            />
            <text wx:if="{{verificationCode}}" class="field-tip">开发环境验证码：{{verificationCode}}</text>
          </view>

          <view class="field-item">
            <text class="field-label">新密码</text>
            <view class="password-row">
              <input
                class="field-input password-input"
                password="{{!showNewPassword}}"
                placeholder="请输入新密码（至少6位）"
                placeholder-class="field-placeholder"
                value="{{newPassword}}"
                bindinput="onNewPasswordInput"
              />
              <text class="toggle-eye" bindtap="toggleNewPassword">{{showNewPassword ? '🙈' : '👁'}}</text>
            </view>
          </view>

          <view class="field-item">
            <text class="field-label">确认密码</text>
            <view class="password-row">
              <input
                class="field-input password-input"
                password="{{!showConfirmPassword}}"
                placeholder="请再次输入新密码"
                placeholder-class="field-placeholder"
                value="{{confirmPassword}}"
                bindinput="onConfirmPasswordInput"
              />
              <text class="toggle-eye" bindtap="toggleConfirmPassword">{{showConfirmPassword ? '🙈' : '👁'}}</text>
            </view>
          </view>
        </view>

        <button class="primary-btn" bindtap="onResetPassword" disabled="{{resetting}}">
          {{resetting ? '重置中...' : '重置密码'}}
        </button>
      </view>
    </view>
  </scroll-view>
</view>
